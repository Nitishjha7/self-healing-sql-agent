# Test image — runs the LLM-free seams with no API key and no Postgres.
# There is no local Python on this machine, so the tests run in a container too.
FROM python:3.11-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt pytest
COPY app ./app
COPY mcp_server ./mcp_server
COPY tests ./tests
COPY pytest.ini .
CMD ["python", "-m", "pytest", "-q"]
