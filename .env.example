POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_DB=employees

DATABASE_URL=postgresql://agent:agent@db:5432/employees

# Host port for the backend (change it if another project already uses 8000)
BACKEND_PORT=8000
FRONTEND_PORT=80

# NEVER put a real key in this file — .env.example is committed to git.
# Copy this file to .env (gitignored) and put the real key there.
GOOGLE_API_KEY=your_gemini_api_key_here

# Model override (optional). Default: gemini-3.5-flash-lite
# Model ids get retired — to check which ones are available:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=$GOOGLE_API_KEY"
GEMINI_MODEL=gemini-3.5-flash-lite

# --- LangSmith tracing (optional) ---
# Set LANGCHAIN_TRACING_V2=true to send every node's LLM call, prompt, and
# latency to LangSmith. Leave it false/unset and the agent runs exactly the
# same with zero tracing overhead — no code path depends on it.
# Get a key at https://smith.langchain.com (free tier).
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=self-healing-sql-agent

# --- Public deployment only ---
# Comma-separated frontend origins allowed to call this API.
# Default is "*" for local dev — NEVER leave the wildcard in production,
# or any site can call your backend and burn your LLM quota.
# ALLOWED_ORIGINS=https://your-project.pages.dev

# Per-IP rate limit on /query (the demo shares one free LLM quota).
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW=60

# Whether an approved write is committed, or run and then rolled back.
# false (default): the approval flow is fully visible and the statement still
# runs (constraints are checked, affected rows reported), then rolls back.
# Keep it this way on a public demo, or any visitor could empty a table.
ALLOW_WRITES=false

# Phase 2 — Model Context Protocol.
# Set true and the agent reaches the database through an MCP server (a stdio
# subprocess) instead of importing the driver directly. Default false: the direct
# call is always faster — the benefit of MCP is a swappable standard interface.
USE_MCP=false
