POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_DB=employees

DATABASE_URL=postgresql://agent:agent@db:5432/employees

# Host port for the backend (dusre projects 8000 use kar rahe ho toh badal lo)
BACKEND_PORT=8000
FRONTEND_PORT=80

# NEVER put a real key in this file — .env.example is committed to git.
# Copy this file to .env (gitignored) and put the real key there.
GOOGLE_API_KEY=your_gemini_api_key_here

# Model override (optional). Default: gemini-3.6-flash
# Purane model names deprecate ho jaate hain — available models check karne ke liye:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=$GOOGLE_API_KEY"
GEMINI_MODEL=gemini-3.6-flash

# --- LangSmith tracing (optional) ---
# Set LANGCHAIN_TRACING_V2=true to send every node's LLM call, prompt, and
# latency to LangSmith. Leave it false/unset and the agent runs exactly the
# same with zero tracing overhead — no code path depends on it.
# Get a key at https://smith.langchain.com (free tier).
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=self-healing-sql-agent
